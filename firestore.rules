rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    function isCmsUser() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/authors/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/authors/$(request.auth.uid)).data.role in ['manager', 'admin', 'super'];
    }

    function isModerator() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/authors/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/authors/$(request.auth.uid)).data.role == 'moderator';
    }

    function canModerate() {
      return isCmsUser() || isModerator();
    }

    function handleReservationKey(handle) {
      return handle.lower().replace('[-_0-9]+', '');
    }

    function confusableBrandKey(handle) {
      return handle.lower()
        .replace('1', 'l')
        .replace('4', 'a')
        .replace('9', 'p')
        .replace('[-_0-9]+', '');
    }

    // Protect official brand names and common impersonation qualifiers without
    // rejecting unrelated words such as "overlap" or "clapping".
    function isReservedBrandKey(key) {
      return key.matches('^(official|real|the|team|weare|my)?(lap|arclapain).*');
    }

    function canClaimHandle(handle) {
      let key = handleReservationKey(handle);
      let reservationPath = /databases/$(database)/documents/handleReservations/$(key);
      return (
        exists(reservationPath) &&
        get(reservationPath).data.ownerUid == request.auth.uid
      ) || (
        !exists(reservationPath) &&
        !isReservedBrandKey(key) &&
        !isReservedBrandKey(confusableBrandKey(handle))
      );
    }

    function isHandleSystemReady() {
      return exists(/databases/$(database)/documents/handleConfig/status) &&
        get(/databases/$(database)/documents/handleConfig/status).data.ready == true;
    }
    
    // Helper function to check if user has admin/super role
    // NOTE: This assumes custom claims are set OR we check a user document.
    // Since custom claims are better for security but require backend setup,
    // we'll check the 'authors' collection for role as per the app's structure.
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/authors/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/authors/$(request.auth.uid)).data.role in ['admin', 'super']);
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/authors/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/authors/$(request.auth.uid)).data.role == 'super';
    }

    // Default: Deny all
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Published articles are public. Drafts stay inside the CMS.
    match /articles/{articleId} {
      allow read: if resource.data.publish == true || isCmsUser();
      allow create: if isAdmin() && (
        (request.resource.data.authorUID == request.auth.uid &&
          request.resource.data.authorRef == /databases/$(database)/documents/authors/$(request.auth.uid) &&
          request.resource.data.authorName == get(/databases/$(database)/documents/authors/$(request.auth.uid)).data.name) ||
        (exists(/databases/$(database)/documents/articleTrash/$(articleId)) &&
          request.resource.data == get(/databases/$(database)/documents/articleTrash/$(articleId)).data.article &&
          !existsAfter(/databases/$(database)/documents/articleTrash/$(articleId)))
      );
      allow update: if isAdmin() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['authorUID', 'authorRef', 'authorName']);
      allow delete: if isAdmin() &&
        existsAfter(/databases/$(database)/documents/articleTrash/$(articleId)) &&
        getAfter(/databases/$(database)/documents/articleTrash/$(articleId)).data.article == resource.data;
    }

    // Deleted articles: admins can restore them or explicitly remove them forever.
    match /articleTrash/{articleId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly(['article', 'deletedAt', 'deletedBy']) &&
        request.resource.data.deletedBy == request.auth.uid &&
        request.resource.data.deletedAt == request.time &&
        exists(/databases/$(database)/documents/articles/$(articleId)) &&
        request.resource.data.article == get(/databases/$(database)/documents/articles/$(articleId)).data &&
        !existsAfter(/databases/$(database)/documents/articles/$(articleId));
      allow update: if false;
      allow delete: if isAdmin();
    }
    
    // News: Public read, Admin write
    // Removed as part of News functionality removal
    
    // Authors/Team: public read; privileged role changes stay privileged.
    match /authors/{userId} {
      allow read: if true;
      allow create: if request.resource.data.uid == userId &&
        (isSuperAdmin() || (isAdmin() && request.resource.data.role != 'super'));
      allow update: if
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['handle']) &&
        (isSuperAdmin() ||
          (isAdmin() && resource.data.role != 'super' && request.resource.data.role != 'super') ||
          (isAuthenticated() && request.auth.uid == userId &&
            request.resource.data.uid == resource.data.uid &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'avatar', 'name', 'city', 'job', 'biography', 'socials'
            ])));
      // Team members are deleted by the server so Auth and Firestore stay in sync.
      allow delete: if false;
    }

    // Public reader accounts. Anyone can view individual user profiles; listing is CMS staff only.
    match /users/{userId} {
      allow get: if true;
      allow list: if isCmsUser();
      allow create: if isAuthenticated() &&
        isHandleSystemReady() &&
        request.auth.uid == userId &&
        request.auth.token.email is string &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'provider', 'handle', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.uid == userId &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 2 &&
        request.resource.data.displayName.size() <= 80 &&
        request.resource.data.photoURL is string &&
        request.resource.data.photoURL.size() >= 1 &&
        request.resource.data.photoURL.size() <= 1000 &&
        request.resource.data.provider in ['password', 'google.com'] &&
        request.resource.data.handle is string &&
        request.resource.data.handle.matches('^[a-z0-9_-]{3,20}$') &&
        canClaimHandle(request.resource.data.handle) &&
        request.resource.data.displayName == request.resource.data.handle &&
        existsAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)) &&
        getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == userId &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.auth.token.email is string &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'photoURL', 'provider', 'handle', 'updatedAt'
        ]) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 2 &&
        request.resource.data.displayName.size() <= 80 &&
        request.resource.data.photoURL is string &&
        request.resource.data.photoURL.size() <= 1000 &&
        request.resource.data.provider in ['password', 'google.com'] &&
        request.resource.data.handle is string &&
        // A handle may be claimed once during onboarding. A non-empty handle
        // must remain unchanged for the lifetime of the reader account.
        (
          (!resource.data.keys().hasAny(['handle']) && request.resource.data.handle == '') ||
          (resource.data.keys().hasAny(['handle']) &&
            request.resource.data.handle == resource.data.handle) ||
          ((!resource.data.keys().hasAny(['handle']) || resource.data.handle == '') &&
            request.resource.data.handle.matches('^[a-z0-9_-]{3,20}$') &&
            isHandleSystemReady() &&
            canClaimHandle(request.resource.data.handle) &&
            existsAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)) &&
            getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == userId)
        ) &&
        (request.resource.data.handle == '' ||
          request.resource.data.displayName == request.resource.data.handle) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;

      // Notifications: user can read, mark read, and delete their own notifications.
      // Creation is reserved for server-side Cloud Functions.
      match /notifications/{notificationId} {
        allow read, update, delete: if isAuthenticated() && request.auth.uid == userId;
        allow create: if false;
      }
    }

    // Exact handles can be checked during authenticated onboarding, but the
    // collection cannot be enumerated.
    match /handles/{handle} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated() &&
        isHandleSystemReady() &&
        handle.matches('^[a-z0-9_-]{3,20}$') &&
        canClaimHandle(handle) &&
        request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle == handle;
      allow update: if false;
      allow delete: if false;
    }

    // Exact lookups provide a friendly onboarding message. Reservations are
    // created only by trusted server functions and cannot be enumerated.
    match /handleReservations/{reservationKey} {
      allow get: if isAuthenticated();
      allow list, create, update, delete: if false;
    }

    match /handleConfig/{configId} {
      allow get: if isAuthenticated() && configId == 'status';
      allow list, create, update, delete: if false;
    }

    // Comments are publicly readable when visible. Owners can edit their own
    // text, while CMS staff can hide, restore, or delete any comment.
    match /comments/{commentId} {
      allow read: if resource.data.status == 'visible' ||
        canModerate() ||
        (isAuthenticated() && resource.data.authorId == request.auth.uid);
      allow create: if isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/articles/$(request.resource.data.articleId)) &&
        get(/databases/$(database)/documents/articles/$(request.resource.data.articleId)).data.publish == true &&
        request.resource.data.keys().hasOnly([
          'articleId', 'articleSlug', 'articleTitle', 'authorId', 'authorName',
          'authorHandle', 'authorPhotoURL', 'content', 'imageUrl', 'imageStoragePath',
          'imageWidth', 'imageHeight', 'images', 'status', 'createdAt', 'updatedAt', 'edited',
          'likeCount', 'dislikeCount', 'replyCount'
        ]) &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.authorName ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName &&
        request.resource.data.authorHandle ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle &&
        request.resource.data.authorHandle.matches('^[a-z0-9_-]{3,20}$') &&
        request.resource.data.authorPhotoURL ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.photoURL &&
        request.resource.data.articleId is string &&
        request.resource.data.articleSlug ==
          get(/databases/$(database)/documents/articles/$(request.resource.data.articleId)).data.slug &&
        request.resource.data.articleTitle ==
          get(/databases/$(database)/documents/articles/$(request.resource.data.articleId)).data.title &&
        request.resource.data.content is string &&
        request.resource.data.content.size() <= 2000 &&
        (request.resource.data.content.size() >= 1 ||
          (request.resource.data.keys().hasAny(['imageUrl', 'images']) &&
            ((request.resource.data.keys().hasAny(['imageUrl']) && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() > 0) ||
             (request.resource.data.keys().hasAny(['images']) && request.resource.data.images is list && request.resource.data.images.size() > 0)))) &&
        (!request.resource.data.keys().hasAny(['images']) || (request.resource.data.images is list && request.resource.data.images.size() <= 4)) &&
        request.resource.data.status == 'visible' &&
        request.resource.data.edited == false &&
        (!request.resource.data.keys().hasAny(['likeCount']) ||
          request.resource.data.likeCount == 0) &&
        (!request.resource.data.keys().hasAny(['dislikeCount']) ||
          request.resource.data.dislikeCount == 0) &&
        (!request.resource.data.keys().hasAny(['replyCount']) ||
          request.resource.data.replyCount == 0) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if (
        isAuthenticated() &&
        resource.data.authorId == request.auth.uid &&
        resource.data.status == 'visible' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'content', 'updatedAt', 'edited'
        ]) &&
        request.resource.data.content is string &&
        request.resource.data.content.size() <= 2000 &&
        (request.resource.data.content.size() >= 1 || resource.data.keys().hasAny(['imageUrl', 'images'])) &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.edited == true
      ) || (
        canModerate() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'moderatedAt', 'moderatedBy'
        ]) &&
        request.resource.data.status in ['visible', 'hidden'] &&
        request.resource.data.moderatedAt == request.time &&
        request.resource.data.moderatedBy == request.auth.uid
      ) || (
        isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pinned', 'pinnedAt', 'pinnedBy'
        ])
      );
      allow delete: if isCmsUser() ||
        (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // One-level public replies. Owners control their own text; CMS staff
    // control visibility and deletion. Reply totals are maintained server-side.
    match /commentReplies/{replyId} {
      allow read: if resource.data.status == 'visible' ||
        canModerate() ||
        (isAuthenticated() && resource.data.authorId == request.auth.uid);
      allow create: if isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/comments/$(request.resource.data.parentCommentId)) &&
        get(/databases/$(database)/documents/comments/$(request.resource.data.parentCommentId)).data.status == 'visible' &&
        request.resource.data.keys().hasOnly([
          'parentCommentId', 'articleId', 'articleSlug', 'articleTitle',
          'authorId', 'authorName', 'authorHandle', 'authorPhotoURL',
          'content', 'imageUrl', 'imageStoragePath', 'imageWidth', 'imageHeight', 'images',
          'status', 'createdAt', 'updatedAt', 'edited'
        ]) &&
        request.resource.data.parentCommentId is string &&
        request.resource.data.articleId ==
          get(/databases/$(database)/documents/comments/$(request.resource.data.parentCommentId)).data.articleId &&
        request.resource.data.articleSlug ==
          get(/databases/$(database)/documents/comments/$(request.resource.data.parentCommentId)).data.articleSlug &&
        request.resource.data.articleTitle ==
          get(/databases/$(database)/documents/comments/$(request.resource.data.parentCommentId)).data.articleTitle &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.authorName ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName &&
        request.resource.data.authorHandle ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle &&
        request.resource.data.authorPhotoURL ==
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.photoURL &&
        request.resource.data.content is string &&
        request.resource.data.content.size() <= 2000 &&
        (request.resource.data.content.size() >= 1 ||
          (request.resource.data.keys().hasAny(['imageUrl', 'images']) &&
            ((request.resource.data.keys().hasAny(['imageUrl']) && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() > 0) ||
             (request.resource.data.keys().hasAny(['images']) && request.resource.data.images is list && request.resource.data.images.size() > 0)))) &&
        (!request.resource.data.keys().hasAny(['images']) || (request.resource.data.images is list && request.resource.data.images.size() <= 4)) &&
        request.resource.data.status == 'visible' &&
        request.resource.data.edited == false &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if (
        isAuthenticated() &&
        resource.data.authorId == request.auth.uid &&
        resource.data.status == 'visible' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'content', 'updatedAt', 'edited'
        ]) &&
        request.resource.data.content is string &&
        request.resource.data.content.size() <= 2000 &&
        (request.resource.data.content.size() >= 1 || resource.data.keys().hasAny(['imageUrl', 'images'])) &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.edited == true
      ) || (
        canModerate() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'moderatedAt', 'moderatedBy'
        ]) &&
        request.resource.data.status in ['visible', 'hidden'] &&
        request.resource.data.moderatedAt == request.time &&
        request.resource.data.moderatedBy == request.auth.uid
      );
      allow delete: if isCmsUser() ||
        (isAuthenticated() && (
          resource.data.authorId == request.auth.uid ||
          (exists(/databases/$(database)/documents/comments/$(resource.data.parentCommentId)) &&
            get(/databases/$(database)/documents/comments/$(resource.data.parentCommentId)).data.authorId == request.auth.uid)
        ));
    }

    // Reactions are written by a trusted callable function so counts cannot be
    // forged. A signed-in user may only read their own reaction state.
    match /commentReactions/{userId}/items/{commentId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // Assets are restricted to CMS users. Public account authentication must
    // never grant access to the content library.
    match /assets/{assetId} {
      allow read, write: if isCmsUser();
    }


    // Meta (Stats): Authenticated users can read
    match /meta/{docId} {
      allow read: if isCmsUser();
      allow write: if isAdmin();
    }

    // Asset Index: Authenticated users can read (for search/stats)
    match /assets_index/{docId} {
      allow read: if isCmsUser();
    }
  }
}
